# Research Assistant CLI - Environment Variables
# Copy this file to .env and fill in your values

# ===== API KEYS =====
# Brave Search API Key (optional but recommended)
# Get your free API key from: https://search.brave.com/settings
BRAVE_API_KEY=your_brave_api_key_here

# ===== LLM CONFIGURATION =====
# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# oobabooga/text-generation-webui Configuration (alternative)
OOBABOOGA_BASE_URL=http://localhost:7860
OOBABOOGA_MODEL=your_model_name_here

# ===== SEARCH ENGINE CONFIGURATION =====
# Custom SearX instances (optional)
SEARX_INSTANCES=https://searx.be,https://search.sapti.me,https://searx.prvcy.eu

# ===== APPLICATION SETTINGS =====
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default search engines (comma-separated)
DEFAULT_ENGINES=searx,brave,yahoo,startpage

# Maximum search results per query
MAX_RESULTS=8

# Request timeout in seconds
REQUEST_TIMEOUT=12

# ===== OUTPUT SETTINGS =====
# Default output directory for saved results
DEFAULT_OUTPUT_DIR=./results

# Enable/disable result saving
SAVE_RESULTS=false 